# Copy this file to .env and fill in real values.

# Where to POST detected Instagram reel links.
# Point this at your Odysseus agent's webhook / API endpoint later.
# For now, during testing, you can point it at https://webhook.site/<your-id>
WEBHOOK_URL=https://webhook.site/replace-me

# Optional: only react to messages from yourself (i.e. messages you send
# to any chat, including "Message yourself" / a chat with your own number).
# Set to "true" while testing so random group chats don't trigger it.
ONLY_FROM_ME=true

# Optional: restrict to a specific chat JID (e.g. your own "Notes to self"
# chat, or a private chat/group you created just for this bot).
# Leave blank to allow any chat that passes ONLY_FROM_ME.
# Find this value from the logs after sending a test message.
ALLOWED_CHAT_JID=
